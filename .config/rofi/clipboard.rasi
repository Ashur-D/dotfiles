/* Import Matugen colors */
@import "colors.rasi"

* {
    background-color: transparent;
}

configuration {
    modi: "dmenu";
    show-icons: true;
    placeholder: "Search...";

}

window {
    width: 600px;
    background-color: var(surface);
    border: 2px solid;
    border-color: var(outline-variant);
    border-radius: 16px;
    padding: 20px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 15px;
}

inputbar {
    background-color: var(surface-container-lowest);
    border: 1px solid;
    border-color: var(outline-variant);
    border-radius: 8px;
    padding: 12px 16px;
    children: [ entry ];
}

prompt {
    text-color: var(on-surface-variant);
}

entry {
    placeholder: "Search Clipboard...";
    placeholder-color: var(on-surface-variant);
    text-color: var(on-surface);
}

listview {
    columns: 1;
    lines: 7;
    spacing: 4px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    border: 0px;
}

element {
    padding: 12px 16px;
    border-radius: 12px;
    cursor: pointer;
    children: [ element-icon, element-text ];
    spacing: 12px;
}

element-icon {
    size: 48px;
    vertical-align: 0.5;
    background-color: transparent;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: var(on-surface);
}

element selected.normal {
    /* The subtle pill highlight from your screenshot */
    background-color: var(surface-container-highest);
    text-color: var(primary);
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
