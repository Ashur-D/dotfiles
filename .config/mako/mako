# 1. ALL GLOBAL SETTINGS MUST GO FIRST
font=Cozette 11
format=<b>%a ⏵</b> %s\n%b
sort=-time
output=DP-2
layer=overlay
anchor=bottom-center
width=300
height=110
margin=5
padding=0,5,10
border-size=2
border-radius=15
icons=0
max-icon-size=64
default-timeout=200
ignore-timeout=1

# 2. INCLUDE MATUGEN HERE (After globals, before specific apps)
include=~/.config/mako/mako-colors

# 3. YOUR CUSTOM BLOCKS GO LAST
[app-name=lightcord]

[summary~="log-.*"]

[app-name=lightcord summary~="(.*(^| )orz|ORZ|sto|STO|otl|OTL( |$).*)"]
invisible=1
