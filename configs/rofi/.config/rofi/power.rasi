/* Import Matugen colors */
@import "colors.rasi"

* {
    background-color: transparent;
}

configuration {
    modi: "dmenu";
    show-icons: false;
}

window {
    width: 40%;
    transparency: "real";
    background-color: var(surface);
    border: 0px solid;
    border-color: var(primary);
    border-radius: 16px;
    padding: 25px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ listview ];
}

listview {
    columns: 3;
    lines: 2;
    spacing: 15px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
}

element {
    /* Top/Bottom padding of 42px perfectly balances the 36px font
       to create a true square matching the column width */
    padding: 42px 0px;
    border-radius: 16px;
    background-color: var(surface-container-low);
    text-color: var(on-surface-variant);
    cursor: pointer;
}

element selected.normal {
    background-color: var(primary);
    text-color: var(on-primary);
}

element-text {
    font: "JetBrainsMono Nerd Font 36";
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: inherit;
}
