@import "colors.rasi"

configuration {
    show-icons: true;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    background-color: transparent;
    text-color: var(on-surface);
}

window {
    width: 80%;
    border: 0;
    border-radius: 1.2em;
    padding: 1em;
    background-color: var(surface);
    location: center;
    anchor: center;
}

mainbox {
    padding: 1em;
    spacing: 1em;
    children: [ "listview" ];
}

listview {
    /* Columns are dynamically injected by the bash script */
    lines: 1;
    spacing: 1.5em;
    padding: 0;
    flow: horizontal;
    fixed-height: true;
    fixed-columns: true;
    scrollbar: false;
}

element {
    orientation: vertical;
    padding: 0.6em;
    border-radius: 1.2em;
    cursor: pointer;
    children: [ "element-icon" ];
}

element selected.normal {
    background-color: var(secondary-container);
}

element-icon {
    size: 22em;
    border-radius: 0.8em;
    cursor: inherit;
}
