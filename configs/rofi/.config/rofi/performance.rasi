/* ~/.config/rofi/power_menu.rasi */

/* Import colors */
@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 16";
    background-color: transparent;
    text-color: var(on-surface);
}

configuration {
    modi: "drun,window";
    show-icons: true;
    disable-history: true;
    bw: 0;
}

window {
    width: 18%;
    background-color: var(surface);
    border-color: var(primary);
    border-width: 0px;
    border-radius: 16px;
    border: 0px solid;
    padding: 25px;
    location: center;
    anchor: center;
}

/* Main container for elements within the window */
mainbox {
    children: [ listview ];
}

/* List View Styling */
listview {
    /* Removed 'type: listview;' as it seems to cause parse errors */
    columns: 1;
    lines: 3; /* Max 3 visible lines */
    spacing: 10px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    padding: 0px;
}

/* Style for each row/element */
element {
    padding: 15px 20px;
    background-color: var(surface-container-low);
    text-color: var(on-surface-variant);
    border-radius: 16px;
    cursor: pointer;
    orientation: horizontal;
    vertical-align: 0.5;
}

element selected.normal {
    background-color: var(primary);
    text-color: var(on-primary);
    border: var(primary-fixed-dim); /* Using a simplified border for selected */
}

/* Styling for the icon */
element-icon {
    size: 32px;
    padding: 0px 10px 0px 0px;
    vertical-align: 0.5;
}

/* Styling for the text */
element-text {
    font: "JetBrainsMono Nerd Font Bold 16";
    text-color: inherit;
    align: center;
}

/* Ensure selected colors apply to text and icon */
element selected.normal element-icon,
element selected.normal element-text {
    color: var(on-primary);
}
