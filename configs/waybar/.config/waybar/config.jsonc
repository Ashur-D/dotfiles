{
  // -----------------------------------------------------
  // Global Settings
  // -----------------------------------------------------
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 48,

  // -----------------------------------------------------
  // Module Layout
  // -----------------------------------------------------
  "modules-left": ["clock"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "group/tray-expander",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu",
  ],

  // -----------------------------------------------------
  // Modules: Left
  // -----------------------------------------------------
  "clock": {
    "format": "{:L%A %I:%M}",
    "format-alt": "{:L%d %B %Y}",
    "tooltip": false,
  },

  // -----------------------------------------------------
  // Modules: Center
  // -----------------------------------------------------
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": " ",
      "default": " ",
      "empty": " ",
    },
    "persistent-workspaces": {
      "*": [1, 2, 3],
    },
  },

  // -----------------------------------------------------
  // Modules: Right (Hardware & Status)
  // -----------------------------------------------------
  "bluetooth": {
    "format": "",
    "format-off": "󰂲 ",
    "format-disabled": "󰂲 ",
    "format-connected": "󰂱 ",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "kitty bluetui",
  },
  "network": {
    "format-icons": [" "],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂 ",
    "format-disconnected": " ",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "kitty impala",
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "kitty wiremix",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": " ",
    "format-icons": {
      "headphone": " ",
      "headset": " ",
      "default": ["", " ", " "],
    },
  },
  "cpu": {
    "interval": 5,
    "format": "󰍛 ",
    "on-click": "kitty btop",
  },

  // -----------------------------------------------------
  // Tray & Expander
  // -----------------------------------------------------
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
    },
    "modules": ["custom/expand-icon", "tray"],
  },
  "custom/expand-icon": {
    "format": " ",
    "tooltip": false,
  },
  "tray": {
    "icon-size": 15,
    "spacing": 10,
  },
}
