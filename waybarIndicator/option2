"custom/recording": {
    "exec": "pgrep -f '^gpu-screen-recorder' >/dev/null 2>&1 && echo '⏺ REC' || echo ''",
    "interval": 1,
    "on-click": "killall -SIGINT gpu-screen-recorder",
    "format": "{}",
    "tooltip-format": "Click to stop recording"
}

---

#custom-recording {
    color: alpha(@primary, 1);
    font-weight: bold;
    padding: 0 10px;
}
